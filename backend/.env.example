PORT=5000

# MongoDB Atlas connection string (example)
# Tip: URL-encode special characters in your password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=7d

# Frontend URL (Render Static Site / custom domain)
# Use http://localhost:3000 for local development.
CLIENT_URL=http://localhost:3000

# Sender identity (must be verified in Brevo)
SMTP_FROM="EventFlow <no-reply@eventflow.local>"

# Brevo (Transactional Email API)
BREVO_API_KEY=your_brevo_api_key
# Optional sender overrides (otherwise SMTP_FROM is used)
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=EventFlow

# AI (choose one)
# Groq (recommended for current backend/controllers/aiController.js setup)
GROQ_API_KEY=your_groq_api_key
# Or OpenAI
# OPENAI_API_KEY=your_openai_api_key

# App name (used in email subject/body)
APP_NAME=EventFlow

# Razorpay test/live keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Event reminder job
# Runs hourly by default. Set to true to disable reminders in a process.
DISABLE_EVENT_REMINDERS=false
# Optional: run one reminder pass shortly after server startup for local testing.
RUN_EVENT_REMINDERS_ON_STARTUP=false
# Optional: controls date/time formatting in reminder emails.
EVENT_TIME_ZONE=Asia/Kolkata

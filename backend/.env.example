PORT=5000

# MongoDB Atlas connection string (example)
# Tip: URL-encode special characters in your password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=7d

# Frontend URL (Render Static Site / custom domain)
# Use http://localhost:3000 for local development.
CLIENT_URL=http://localhost:3000

# Sender identity (must be verified in Brevo)
SMTP_FROM="EventFlow <no-reply@eventflow.local>"

# Brevo (Transactional Email API)
BREVO_API_KEY=your_brevo_api_key
# Optional sender overrides (otherwise SMTP_FROM is used)
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=EventFlow

# App name (used in email subject/body)
APP_NAME=EventFlow
